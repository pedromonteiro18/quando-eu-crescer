      "cefr": "A1",
      "instructions": "spoken",
      "categories": ["greetings", "numbers", "family", "jobs", "food", "school"],
      "grammar": [
        "Present simple, all persons",
        "Frequency: always, usually, never",
        "can / can't",
        "Prepositions of place",
        "some / any"
      ],
      "activities": { "listen": "picture", "read": "dialogue", "speak": "echo", "write": "bank", "quiz": "text" },
      "lesson": { "vocab": 8, "listen": 5, "read": 4, "speak": 3, "write": 4, "quiz": 5 },
      "hintAfter": 2,
      "scale": 1.12,
      "unitTest": { "everyCategories": 2, "items": 8, "pass": 0.7 },
      "assessment": { "items": 12, "pass": 0.75, "unlocks": "11-14" }
    },
    {
      "id": "11-14",
      "label": "Building Up",
      "ages": "11 to 14",
      "cefr": "A2",
      "instructions": "spoken + written",
      "categories": ["food", "school", "travel", "conversations"],
      "grammar": [
        "Past simple, regular and irregular",
        "going to for plans",
        "Comparatives and superlatives",
        "Present perfect for experience",
        "Indirect questions"
      ],
      "activities": { "listen": "text", "read": "passage", "speak": "echo", "write": "type", "quiz": "text" },
      "lesson": { "vocab": 10, "listen": 5, "read": 4, "speak": 3, "write": 5, "quiz": 6 },
      "hintAfter": 0,
      "scale": 1,
      "unitTest": { "everyCategories": 2, "items": 8, "pass": 0.75 },
      "assessment": { "items": 14, "pass": 0.75, "unlocks": "15+" }
    },
    {
      "id": "15+",
      "label": "Real English",
      "ages": "15 and up",
      "cefr": "B1",
      "instructions": "written",
      "categories": ["travel", "conversations", "phrasal-verbs"],
      "grammar": [
        "Question tags",
        "used to and would for past habits",
        "Reported speech",
        "Conditionals 1 and 2",
        "Phrasal verbs: separable, inseparable, three-part",
        "Register: spoken versus written"
      ],
      "activities": { "listen": "text", "read": "passage", "speak": "echo", "write": "free", "quiz": "text" },
      "note": "write is 4, not 5: a free written answer is the slowest item in the app, and five of them pushed this band past the twelve minute target.",
      "lesson": { "vocab": 10, "listen": 6, "read": 5, "speak": 3, "write": 4, "quiz": 7 },
      "hintAfter": 0,
      "scale": 0.96,
      "unitTest": { "everyCategories": 2, "items": 10, "pass": 0.75 },
      "assessment": { "items": 16, "pass": 0.8, "unlocks": null }
    }
  ],

