{
  "version": 1,
  "note": "Bands are presentation levels, chosen by age. CEFR is the content level, chosen by the placement ladder. A category is offered when its CEFR is at or just above the learner's level; the band decides how it is presented.",

  "cefrOrder": ["Pre-A1", "A1", "A2", "B1", "B2"],

  "categoryFiles": [
    "greetings", "numbers", "family", "jobs", "food", "school",
    "travel", "conversations", "phrasal-verbs", "weather"
  ],

  "confusable": {
    "note": "Pairs that genuinely confuse — two red faces, two similar figures — never offered in the same question. Carried over from the prototype, where sick and hot were the pair that proved it was needed.",
    "pairs": [
      ["sick", "hot"],
      ["hungry", "delicious"],
      ["morning", "afternoon"],
      ["evening", "night"],
      ["mother", "father"],
      ["grandmother", "grandfather"],
      ["aunt", "uncle"],
      ["son", "daughter"],
      ["hello", "hi"],
      ["agree", "accept"]
    ]
  },

  "bands": [
    {
      "id": "4-6",
      "label": "First Words",
      "ages": "4 to 6",
      "cefr": "Pre-A1",
      "instructions": "none",
      "categories": ["greetings", "numbers", "family", "jobs"],
      "grammar": [
        "This is my + person",
        "Good + time of day",
        "Numbers to twenty",
        "Imperatives: get, put, give"
      ],
      "activities": { "listen": "picture", "read": "match", "speak": "echo", "write": "tiles", "quiz": "picture" },
      "lesson": { "vocab": 6, "listen": 4, "read": 4, "speak": 2, "write": 3, "quiz": 4 },
      "hintAfter": 1,
      "scale": 1.3,
      "unitTest": { "everyCategories": 2, "items": 6, "pass": 0.66 },
      "assessment": { "items": 10, "pass": 0.7, "unlocks": "7-10" }
    },
    {
      "id": "7-10",
      "label": "Getting Started",
