  "phrases": [
    {
      "text": "Good morning.",
      "use": "Before midday."
    },
    {
      "text": "Good afternoon.",
      "use": "From midday until about six."
    },
    {
      "text": "Good evening.",
      "use": "After about six, when you arrive."
    },
    {
      "text": "Good night.",
      "use": "Only when you leave, or before sleep."
    },
    {
      "text": "How are you?",
      "use": "The normal reply to a greeting."
    },
    {
      "text": "Nice to meet you.",
      "use": "The first time you meet someone."
    },
    {
      "text": "See you tomorrow.",
      "use": "When you know you will meet again."
    }
  ],
